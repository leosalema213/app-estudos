{
  "name": "compasso-estudos",
  "version": "0.4.2",
  "private": true,
  "description": "Seu ritmo de estudo, um bloco de cada vez.",
  "author": "Compasso",
  "repository": { "type": "git", "url": "https://github.com/leosalema213/app-estudos.git" },
  "homepage": "https://github.com/leosalema213/app-estudos",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.cjs",
    "test:installer": "node tests/installer-mode.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "icon": "node scripts/create-icon.cjs",
    "release": "node scripts/publish-release.cjs",
    "checksums": "node scripts/checksums.cjs"
  },
  "devDependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "br.com.compasso.estudos",
    "productName": "Compasso",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Compasso-Instalar.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerLanguages": ["pt_BR"],
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": { "artifactName": "Compasso-${version}-Portatil.exe" }
  }
}

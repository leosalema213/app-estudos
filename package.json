{
  "name": "compasso-estudos",
  "version": "0.4.7",
  "private": true,
  "description": "Seu ritmo de estudo, um bloco de cada vez.",
  "author": "Organon",
  "repository": {
    "type": "git",
    "url": "https://github.com/leosalema213/app-estudos.git"
  },
  "homepage": "https://github.com/leosalema213/app-estudos",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui.cjs",
    "test:notebook": "node tests/notebook.cjs",
    "test:library": "node tests/library.cjs",
    "test:reminders": "node tests/reminders.cjs",
    "test:plans": "node tests/plans.cjs",
    "test:windows-startup": "node tests/windows-startup.cjs",
    "test:installer": "node tests/installer-mode.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "icon": "node scripts/create-icon.cjs",
    "release": "node scripts/publish-release.cjs",
    "checksums": "node scripts/checksums.cjs"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^1.62.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "br.com.compasso.estudos",
    "productName": "Organon",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [{ "from": "assets/icon.ico", "to": "icon.ico" }],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Organon-Instalar.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "pt_BR"
      ],
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Organon-${version}-Portatil.exe"
    }
  }
}
